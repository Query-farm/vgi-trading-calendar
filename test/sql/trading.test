# name: test/sql/trading.test
# description: End-to-end ATTACH + query of the trading / exchange-calendar functions.
# group: [vgi_trading_calendar]

require-env VGI_TRADING_CALENDAR_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'tcal' AS tcal (TYPE vgi, LOCATION '{VGI_TRADING_CALENDAR_WORKER}');

# ---------------------------------------------------------------------------
# Trading-day predicates and navigation (default exchange XNYS = NYSE)
# ---------------------------------------------------------------------------

# New Year's Day 2026 is not an NYSE session; the next weekday is.
query I
SELECT tcal.is_trading_day(DATE '2026-01-01');
----
false

query I
SELECT tcal.is_trading_day(DATE '2026-01-02');
----
true

query I
SELECT tcal.next_trading_day(DATE '2026-01-01');
----
2026-01-02

# previous_trading_day is strict (before, never equal).
query I
SELECT tcal.previous_trading_day(DATE '2026-01-02');
----
2025-12-31

query I
SELECT tcal.add_trading_days(DATE '2026-01-02', 5);
----
2026-01-09

query I
SELECT tcal.add_trading_days(DATE '2026-01-02', -1);
----
2025-12-31

# Half-open [start, end) count of sessions in January 2026.
query I
SELECT tcal.trading_days_between(DATE '2026-01-01', DATE '2026-02-01');
----
20

# ---------------------------------------------------------------------------
# Market hours (UTC instants) + early closes
# ---------------------------------------------------------------------------

# Compare to TIMESTAMPTZ literals so the assertion is timezone-independent.
query I
SELECT tcal.market_open(DATE '2026-01-02') = TIMESTAMPTZ '2026-01-02 14:30:00+00';
----
true

query I
SELECT tcal.market_close(DATE '2026-01-02') = TIMESTAMPTZ '2026-01-02 21:00:00+00';
----
true

# Day after US Thanksgiving: an early close at 18:00 UTC (13:00 ET), not 21:00.
query I
SELECT tcal.is_early_close(DATE '2026-11-27');
----
true

query I
SELECT tcal.market_close(DATE '2026-11-27') = TIMESTAMPTZ '2026-11-27 18:00:00+00';
----
true

# Non-sessions have no early-close answer.
query I
SELECT tcal.is_early_close(DATE '2026-01-03') IS NULL;
----
true

# Outside the exchange-calendars coverage window the worker has no data:
# NULL, never a guessed "closed" or a short count.
query III
SELECT tcal.is_trading_day(DATE '1800-01-02') IS NULL,
       tcal.add_trading_days(DATE '1800-01-02', 1) IS NULL,
       tcal.trading_days_between(DATE '1800-01-02', DATE '2026-01-02') IS NULL;
----
true	true	true

# Hours are NULL on a non-session.
query I
SELECT tcal.market_open(DATE '2026-01-01') IS NULL;
----
true

# ---------------------------------------------------------------------------
# Per-exchange behaviour
# ---------------------------------------------------------------------------

# 2026-07-03 (US July-4-observed holiday) is a normal London session.
query I
SELECT tcal.is_trading_day(DATE '2026-07-03', 'XLON');
----
true

query I
SELECT tcal.is_trading_day(DATE '2026-07-03', 'XNYS');
----
false

# Unknown exchange code is a clear error, not a silent wrong answer.
statement error
SELECT tcal.is_trading_day(DATE '2026-01-02', 'NOPE');
----

# ---------------------------------------------------------------------------
# Set-returning trading table functions
# ---------------------------------------------------------------------------

query I
SELECT count(*) FROM tcal.trading_sessions(DATE '2026-01-01', DATE '2026-01-31');
----
20

query I
SELECT is_early_close FROM tcal.trading_schedule(DATE '2026-11-27', DATE '2026-11-27');
----
true

query I
SELECT count(*) FROM tcal.exchanges WHERE code IN ('XNYS', 'XNAS', 'XLON', 'XTKS');
----
4

# XNYS (NYSE) is present exactly once (asserts the agent_test_tasks reference).
query I
SELECT count(*) FROM tcal.exchanges WHERE code = 'XNYS';
----
1

# trading_sessions exposes its session date as the `session` column.
query I
SELECT count(*) FROM tcal.trading_sessions(DATE '2026-01-01', DATE '2026-01-31') WHERE session = DATE '2026-01-02';
----
1

# Coverage is broad — the 'XNYS' default is just a default.
query I
SELECT count(*) > 50 FROM tcal.exchanges;
----
true

# ---------------------------------------------------------------------------
# Composed examples (vgi_trading_calendar/composed.py) — several tcal objects
# in one query. Keep these in sync with the published example SQL.
# ---------------------------------------------------------------------------

# trading_sessions + is_trading_day: NYSE open, London closed (UK bank holidays).
query I
SELECT s.session FROM tcal.main.trading_sessions(DATE '2026-01-01', DATE '2026-12-31') AS s WHERE NOT tcal.main.is_trading_day(s.session, 'XLON') ORDER BY s.session
----
2026-04-06
2026-05-04
2026-08-31
2026-12-28

# trading_sessions + add_trading_days: T+1 settlement skips Thanksgiving.
query II
SELECT s.session AS trade_date, tcal.main.add_trading_days(s.session, 1) AS settles_t1 FROM tcal.main.trading_sessions(DATE '2026-11-23', DATE '2026-11-30') AS s ORDER BY s.session
----
2026-11-23	2026-11-24
2026-11-24	2026-11-25
2026-11-25	2026-11-27
2026-11-27	2026-11-30
2026-11-30	2026-12-01

# trading_schedule + next_trading_day + market_open: half-days (18:00 UTC close) and
# the next open (14:30 UTC); epoch() keeps the check timezone-independent.
query IIII
SELECT sc.session, epoch(sc.market_close) = epoch(sc.session + INTERVAL 18 HOUR), tcal.main.next_trading_day(sc.session) AS next_session, epoch(tcal.main.market_open(tcal.main.next_trading_day(sc.session))) = epoch(tcal.main.next_trading_day(sc.session) + INTERVAL '14 hours 30 minutes') FROM tcal.main.trading_schedule(DATE '2026-01-01', DATE '2026-12-31') AS sc WHERE sc.is_early_close ORDER BY sc.session
----
2026-11-27	true	2026-11-30	true
2026-12-24	true	2026-12-28	true

# trading_schedule XNYS joined to XLON: overlap widens during the US/UK DST gap.
query III
SELECT date_diff('minute', greatest(ny.market_open, ln.market_open), least(ny.market_close, ln.market_close)) AS overlap_minutes, count(*) AS n_sessions, min(ny.session) AS first_session FROM tcal.main.trading_schedule(DATE '2026-03-01', DATE '2026-04-30') AS ny JOIN tcal.main.trading_schedule(DATE '2026-03-01', DATE '2026-04-30', exchange := 'XLON') AS ln USING (session) GROUP BY overlap_minutes ORDER BY first_session
----
120	27	2026-03-02
180	15	2026-03-09

# Grader for agent task nyse-2026-t1-settlement-gaps (vgi-agent-tests.yaml).
query I
SELECT count(*) AS n FROM tcal.main.trading_sessions(DATE '2026-01-01', DATE '2026-12-31') AS s WHERE tcal.main.add_trading_days(s.session, 1) > s.session + 1
----
54

statement ok
DETACH tcal;
